<%
const src = 'uploads/' + img.file_name;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rename image · Gallery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="orb orb--lavender orb--tl" aria-hidden="true"></div>
    <div class="orb orb--peach orb--br" aria-hidden="true"></div>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="/">Gallery</a>
            <nav class="nav">
                <a href="/"><i data-lucide="images"></i><span>My images</span></a>
                <a href="/favorites"><i data-lucide="heart"></i><span>Favorites</span></a>
                <a href="/logout"><i data-lucide="log-out"></i><span>Log out</span></a>
            </nav>
        </div>
    </header>

    <main class="page">
        <a class="back-link" href="/">
            <i data-lucide="arrow-left"></i> Back to gallery
        </a>

        <div class="page-title">
            <div>
                <h1 class="display">Rename image</h1>
                <p class="lead">Give this image a name you will recognize.</p>
            </div>
        </div>

        <div class="card">
            <% if (error) { %>
                <div class="alert alert-error">
                    <i data-lucide="circle-alert"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <div class="preview">
                <a href="<%= src %>" target="_blank" rel="noopener">
                    <img src="<%= src %>" alt="<%= img.title %>">
                </a>
            </div>

            <form method="POST" action="/edit/<%= img.id %>" class="form-stack">
                <div>
                    <label for="title">Image name</label>
                    <input id="title" type="text" name="title" required
                           value="<%= img.title %>">
                    <span class="field-hint">Original file: <%= img.file_name %></span>
                </div>
                <div class="actions">
                    <button class="btn btn-primary" type="submit">
                        <i data-lucide="save"></i>
                        Save name
                    </button>
                    <a class="btn btn-outline" href="/">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <script>lucide.createIcons();</script>
</body>
</html>
