# Local configuration — copy .env.example to .env and fill in real values.
# This file is gitignored and never pushed to GitHub.

PORT=3000
DB_HOST=localhost
DB_NAME=userdb
DB_USER=appuser
DB_PASS=apppass
SESSION_SECRET=change-me-to-a-long-random-string

# MySQL container credentials (same values are used by the app via compose)
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=userdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-app-password